
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  draft
  sent
  partial
  paid
  overdue
}

enum PaymentMethod {
  upi
  cash
  bank
}

enum PaymentSource {
  manual
  quick_log
}

enum BillCategory {
  rent
  internet
  materials
  other
}

enum BillStatus {
  unpaid
  paid
}

enum ReminderTone {
  friendly
  firm
  final_notice
}

enum ReminderLanguage {
  english
  hindi
  telugu
}

enum ReminderStatus {
  draft
  sent
}

enum ReminderChannel {
  whatsapp
  copy
  other
}

enum AlertType {
  overdue_chase
  final_notice
  due_tomorrow
  forecast_shortfall
  bill_due_low_cash
  billing_day_reached
}

enum AlertSeverity {
  critical
  warning
  info
}

enum AlertStatus {
  open
  snoozed
  dismissed
  acted
}

model TutorProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  name                  String
  upiId                 String?  @map("upi_id")
  openingCashBalance    Decimal  @default(0) @map("opening_cash_balance") @db.Decimal(12, 2)
  onboardingCompleted   Boolean  @default(false) @map("onboarding_completed")

  @@map("tutor_profiles")
}

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  parentName   String    @map("parent_name")
  studentName  String    @map("student_name")
  phone        String
  subject      String
  monthlyFee   Decimal   @map("monthly_fee") @db.Decimal(12, 2)
  billingDay   Int       @map("billing_day")
  isActive     Boolean   @default(true) @map("is_active")
  isDemo       Boolean?  @map("is_demo")

  invoices     Invoice[]  @relation("CustomerInvoices")
  payments     Payment[]  @relation("CustomerPayments")
  reminders    Reminder[] @relation("CustomerReminders")
  alerts       Alert[]    @relation("AlertCustomer")

  @@index([phone])
  @@index([isActive])
  @@map("customers")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  invoiceNumber  String        @unique @map("invoice_number")
  customerId     String        @map("customer_id") @db.Uuid
  billingMonth   DateTime?     @map("billing_month") @db.Date
  issuedDate     DateTime      @map("issued_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  status         InvoiceStatus @default(draft)
  sentAt         DateTime?     @map("sent_at")
  paidAt         DateTime?     @map("paid_at")
  isDemo         Boolean?      @map("is_demo")

  customer       Customer          @relation("CustomerInvoices", fields: [customerId], references: [id])
  lineItems      InvoiceLineItem[] @relation("InvoiceLineItems")
  payments       Payment[]         @relation("InvoicePayments")
  reminders      Reminder[]        @relation("InvoiceReminders")
  alerts         Alert[]           @relation("AlertInvoice")

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  invoiceId    String   @map("invoice_id") @db.Uuid
  description  String
  quantity     Int      @default(1)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(12, 2)
  isDemo       Boolean? @map("is_demo")

  invoice      Invoice  @relation("InvoiceLineItems", fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id          String         @id @default(uuid()) @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  customerId  String         @map("customer_id") @db.Uuid
  invoiceId   String         @map("invoice_id") @db.Uuid
  amount      Decimal        @db.Decimal(12, 2)
  receivedOn  DateTime       @map("received_on") @db.Date
  method      PaymentMethod  @default(upi)
  reference   String?
  source      PaymentSource  @default(manual)
  isDemo      Boolean?       @map("is_demo")

  customer    Customer       @relation("CustomerPayments", fields: [customerId], references: [id])
  invoice     Invoice        @relation("InvoicePayments", fields: [invoiceId], references: [id])

  @@index([customerId])
  @@index([invoiceId])
  @@index([receivedOn])
  @@map("payments")
}

model Bill {
  id          String       @id @default(uuid()) @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  name        String
  category    BillCategory @default(other)
  amount      Decimal      @db.Decimal(12, 2)
  dueDate     DateTime     @map("due_date") @db.Date
  isRecurring Boolean      @default(false) @map("is_recurring")
  status      BillStatus   @default(unpaid)
  paidOn      DateTime?    @map("paid_on") @db.Date
  isDemo      Boolean      @default(false) @map("is_demo")

  alerts      Alert[]      @relation("AlertBill")

  @@index([dueDate])
  @@index([status])
  @@map("bills")
}

model Reminder {
  id                  String           @id @default(uuid()) @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  customerId          String           @map("customer_id") @db.Uuid
  invoiceId           String           @map("invoice_id") @db.Uuid
  alertId             String?          @map("alert_id") @db.Uuid
  tone                ReminderTone     @default(friendly)
  language            ReminderLanguage @default(english)
  messageBody         String           @map("message_body")
  daysLateAtCreation  Int              @default(0) @map("days_late_at_creation")
  status              ReminderStatus   @default(draft)
  channel             ReminderChannel?
  sentAt              DateTime?        @map("sent_at")
  isDemo              Boolean?         @map("is_demo")
  badDayBatchId       String?          @map("bad_day_batch_id")
  badDayRank          Int?             @map("bad_day_rank")

  customer            Customer         @relation("CustomerReminders", fields: [customerId], references: [id])
  invoice             Invoice          @relation("InvoiceReminders", fields: [invoiceId], references: [id])
  alert               Alert?           @relation("ReminderAlert", fields: [alertId], references: [id])

  @@index([customerId])
  @@index([invoiceId])
  @@index([alertId])
  @@index([status])
  @@index([badDayBatchId])
  @@map("reminders")
}

model Alert {
  id             String        @id @default(uuid()) @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  alertType      AlertType     @map("alert_type")
  severity       AlertSeverity @default(info)
  message        String
  actionLabel    String        @map("action_label")
  status         AlertStatus   @default(open)
  snoozedUntil   DateTime?     @map("snoozed_until")
  dismissedAt    DateTime?     @map("dismissed_at")
  actedAt        DateTime?     @map("acted_at")
  shortfallDate  DateTime?     @map("shortfall_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date
  customerId     String?       @map("customer_id") @db.Uuid
  invoiceId      String?       @map("invoice_id") @db.Uuid
  billId         String?       @map("bill_id") @db.Uuid
  dedupeKey      String?       @unique @map("dedupe_key")
  isDemo         Boolean?      @map("is_demo")
  invoiceIds     Json?         @map("invoice_ids")

  customer       Customer?     @relation("AlertCustomer", fields: [customerId], references: [id])
  invoice        Invoice?      @relation("AlertInvoice", fields: [invoiceId], references: [id])
  bill           Bill?         @relation("AlertBill", fields: [billId], references: [id])
  reminders      Reminder[]    @relation("ReminderAlert")

  @@index([status])
  @@index([customerId])
  @@index([invoiceId])
  @@index([billId])
  @@map("alerts")
}